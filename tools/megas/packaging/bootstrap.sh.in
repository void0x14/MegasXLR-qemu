#!/bin/sh
# Generated by bundle.py with a fork-specific release URL and pinned SHA256.
set -eu
exec 3>&2
diagnostic_dir=${XDG_STATE_HOME:-"$HOME/.local/state"}/megas/installation
if mkdir -p -- "$diagnostic_dir" 2>/dev/null; then
    diagnostic=$diagnostic_dir/last-bootstrap.log
else
    diagnostic=$(mktemp "${TMPDIR:-/tmp}/megas-bootstrap.XXXXXX" 2>/dev/null) || { printf 'Copy to your agent: Repair Megas bootstrap; no writable diagnostic directory is available.\n' >&3; exit 1; }
fi
exec 2>>"$diagnostic"
url=@URL@
expected=@SHA256@
work=$(mktemp -d)
pid=
stage=download
cleanup() {
    result=$?
    [ -z "$pid" ] || { kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; }
    if [ "$result" -ne 0 ]; then
        printf '\nCopy this to your agent:\nRepair the Megas bootstrap. Stage: %s. Expected SHA256: %s. Release: %s. Diagnostic log: %s. Preserve my VM disks, verify the release bundle, and retry the per-user installation; ask my desktop icon preference. Do not install global packages or disable checksum verification.\n' "$stage" "$expected" "$url" "$diagnostic" >&3
    fi
    rm -rf -- "$work"
}
trap cleanup EXIT HUP INT TERM
printf '[1/3] Downloading the application and its private dependencies…\n'
if command -v curl >/dev/null 2>&1; then
    curl --fail --location --proto '=https' --tlsv1.2 --silent --show-error "$url" -o "$work/bundle.tar.gz" 2>>"$diagnostic" &
elif command -v wget >/dev/null 2>&1; then
    wget --https-only --quiet -O "$work/bundle.tar.gz" "$url" 2>>"$diagnostic" &
else
    stage='no supported built-in download transport'
    exit 1
fi
pid=$!
printf 'Download process: %s\n' "$pid"
while kill -0 "$pid" 2>/dev/null; do
    bytes=$(wc -c < "$work/bundle.tar.gz" 2>/dev/null || printf '0')
    printf '\rDownloaded: %s bytes' "$bytes"
    sleep 1
done
wait "$pid"
pid=
printf '\n[2/3] Verifying the release checksum…\n'
stage=verification
printf '%s  %s\n' "$expected" "$work/bundle.tar.gz" | sha256sum --quiet -c -
tar -xzf "$work/bundle.tar.gz" -C "$work"
stage=installation
printf '[3/3] Installing…\n'
"$work/@BUNDLE@/packaging/install.sh" "$@"
