{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "\"@MEGAS@\" hook SessionStart", "timeout": 3}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "\"@MEGAS@\" hook UserPromptSubmit", "timeout": 3}]}],
    "PreToolUse": [{"matcher": ".*", "hooks": [{"type": "command", "command": "\"@MEGAS@\" hook PreToolUse", "timeout": 3}]}],
    "PostToolUse": [{"matcher": ".*", "hooks": [{"type": "command", "command": "\"@MEGAS@\" hook PostToolUse", "timeout": 3}]}]
  }
}
