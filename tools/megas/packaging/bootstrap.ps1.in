# Generated by bundle.py with a fork-specific release URL and pinned SHA256.
[CmdletBinding()]
param([ValidateSet('Ask','Yes','No')][string]$DesktopIcon = 'Ask', [switch]$Agent)
$ErrorActionPreference = 'Stop'
$url = '@URL@'
$expected = '@SHA256@'
$stage = 'download'
$work = Join-Path $env:TEMP ('megas-bootstrap-' + [Guid]::NewGuid().ToString('N'))
$diagnostic = Join-Path $env:TEMP 'megas-bootstrap-last.log'
function Write-BootstrapLog([string]$Message) {
    try { Add-Content -LiteralPath $diagnostic -Value "[$([DateTime]::UtcNow.ToString('o'))] $Message" } catch { }
}
try {
    New-Item -ItemType Directory -Path $work | Out-Null
    Write-Host "Bootstrap process ID: $PID"
    Write-BootstrapLog "bootstrap.begin pid=$PID release=$url"
    Write-Progress -Activity 'Installing Megas' -Status 'Downloading the application and private dependencies' -PercentComplete 10
    $archive = Join-Path $work 'bundle.zip'
    Invoke-WebRequest -Uri $url -OutFile $archive -UseBasicParsing
    $stage = 'verification'
    Write-BootstrapLog "stage=$stage archive=$archive"
    Write-Progress -Activity 'Installing Megas' -Status 'Verifying the release checksum' -PercentComplete 70
    if ((Get-FileHash -Algorithm SHA256 -LiteralPath $archive).Hash.ToLowerInvariant() -ne $expected) { throw 'Release checksum mismatch' }
    Expand-Archive -LiteralPath $archive -DestinationPath $work
    $stage = 'installation'
    Write-BootstrapLog "stage=$stage bundle=@BUNDLE@"
    & (Join-Path $work '@BUNDLE@\packaging\install.ps1') -DesktopIcon $DesktopIcon -Agent:$Agent
    if ($LASTEXITCODE -and $LASTEXITCODE -ne 0) { throw 'Per-user installation failed' }
    Write-Progress -Activity 'Installing Megas' -Completed
    Write-BootstrapLog 'bootstrap.complete'
} catch {
    Write-Progress -Activity 'Installing Megas' -Completed
    Write-BootstrapLog "bootstrap.failed stage=$stage error=$($_.Exception.Message)"
    $prompt = "Repair the Megas bootstrap. Stage: $stage. Diagnostic: $($_.Exception.Message). Diagnostic log: $diagnostic. Expected SHA256: $expected. Release: $url. Preserve my VM disks, verify the release bundle, and retry the per-user installation. Ask my desktop icon preference. Do not install global packages or disable checksum verification."
    Write-Host "`nCopy this to your agent:`n$prompt"
    try { Set-Clipboard -Value $prompt } catch { }
    try { $prompt | Set-Content -LiteralPath (Join-Path $env:TEMP 'megas-install-repair.txt') } catch { }
    exit 1
} finally {
    if (Test-Path -LiteralPath $work) { Remove-Item -LiteralPath $work -Recurse -Force }
}
